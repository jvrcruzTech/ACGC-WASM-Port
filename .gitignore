# IDE folders
.idea/
.vs/
.vscode/*

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
build32/
pc/build-wasm*/
pc/include/generated/
.ninja_*
build.ninja
cmake-build-*/
CMakeFiles/
CMakeCache.txt

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!requirements.txt
*.exe
*.py[cod]

# For saving work files into (like IDB)
temp/

*.ciso
*.iso
*.gcm

# Ignore the N64 SDK headers since we download them
# NOTE: include/PR/gbi.h and include/PR/ultratypes.h are force-tracked
# (git add -f) because they have TARGET_PC modifications for LE bitfields.
# configure.py skips download when they already exist.
include/PR/
include/gcc/
include/compiler/gcc/stdlib.h
